# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# "mock" uses bundled sample data (no key needed). "live" calls CoinGecko.
DATA_SOURCE=mock

# Free Demo key: https://www.coingecko.com/en/api  (required when DATA_SOURCE=live)
COINGECKO_API_KEY=your-demo-api-key-here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
UPSTREAM_TIMEOUT_MS=8000

# Comma-separated browser origins allowed to call the API, or * for any.
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
